# Container environment variables. Anything below can be set on the container.
#
# Shared by both apps:
PUID=99
PGID=100
UMASK=002
TZ=America/New_York
LIBRARY_SPLIT=10000
SLEEP_INTERVAL=3600

# One app only: put FOLIO_ or NEXUS_ in front. The prefix is removed for that app and the
# other app never sees it.
FOLIO_REQUEST_DELAY_MS=2000
NEXUS_REQUEST_DELAY_MS=1500
# FOLIO_NHENTAI_TAGS=
# NEXUS_HN_TAGS=
# FOLIO_USER_AGENT=
# NEXUS_USER_AGENT=
# NEXUS_MAX_PER_CYCLE=10
# FOLIO_MAX_SEARCH_PAGES=0
#
# Each app keeps its own saved settings in /app/config/folio and /app/config/nexus,
# and its own .env there (/app/config/folio/.env, /app/config/nexus/.env).
